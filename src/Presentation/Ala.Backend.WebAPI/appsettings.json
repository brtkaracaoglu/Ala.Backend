{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "ApplicationName": "Ala.Backend.WebAPI"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ala-backend-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [CID:{CorrelationId}] [PID:{ProcessId}] [TID:{ThreadId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5430;Database=AlaBackendWebAPI;Username=postgres;Password=sCd06;"
  },

  "JwtSettings": {
    "Issuer": "Ala.Backend",
    "Audience": "Ala.Backend.Client",
    "SigningKey": "QnVTYWhhZGE2NEthcmFrdGVybGlrQmlyU2lmcmVWYXJkaXIxMjM0NTY=",
    "UseEncryption": true,
    "EncryptionKey": "QFNWkZ/UhPNyXXKSf7NsRywKVNgwPFx2oOPpDj6EhUc=",
    "RequireHttpsMetadata": true,
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 60
  },
  "JwtCookieSettings": {
    "HttpOnly": true,
    "Secure": true,
    "SameSite": "None",
    "IsEssential": true,
    "AccessTokenPath": "/",
    "RefreshTokenPath": "/"
  },
  "MailSettings": {
    "Host": "mail.girisimelk.com.tr",
    "Port": 587,
    "Username": "scada@europowersolar.com",
    "Password": "es0606",
    "DisplayName": "EuroScada R&D Dev Team",
    "EnableSsl": false,
    "ClientUrl": "https://localhost:7124/scalar/v1",
    "AdminEmail": "brtkaracaoglu@gmail.com",
    "IgnoreSslErrors": true
  },
  "AuthCleanupSettings": {
    "RefreshTokenRetentionDays": 30,
    "UserSessionRetentionDays": 60,
    "IntervalHours": 24
  }
}
